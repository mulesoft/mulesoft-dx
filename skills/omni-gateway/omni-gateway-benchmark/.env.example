# AWS
AWS_REGION=us-east-2
CLUSTER_NAME=flex-bench

# Flex image. Defaults to the official MuleSoft repo at FLEX_VERSION.
# Override FLEX_IMAGE_REPOSITORY to use a private mirror or a custom build,
# and FLEX_IMAGE_TAG to decouple the tag from FLEX_VERSION.
FLEX_VERSION=1.13.0
FLEX_IMAGE_REPOSITORY=mulesoft/flex-gateway
FLEX_IMAGE_TAG=

# Scenario
N_APIS=10
POLICIES=rate-limit,client-id-enforcement
RPS=1000
VUS=200
DURATION=2m

# Required when POLICIES contains client-id-enforcement.
# k6 sends these as `client_id`/`client_secret` request headers; Flex's
# client-id-enforcement policy 401s every request when they're empty,
# tripping the http_req_failed threshold.
CLIENT_ID=
CLIENT_SECRET=

# Snapshot
GRAFANA_PORT=33000

# Run mgmt
TEARDOWN=0
