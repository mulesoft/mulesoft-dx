{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anypoint.mulesoft.com/schemas/push/openapi.json",
  "title": "OpenAPI or Swagger document",
  "type": "object",
  "anyOf": [
    {
      "required": ["openapi", "info", "paths"],
      "properties": {
        "openapi": {
          "type": "string",
          "pattern": "^3\\.[0-9]+\\.[0-9]+$"
        },
        "info": {
          "type": "object",
          "required": ["title", "version"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "paths": { "type": "object" }
      }
    },
    {
      "required": ["swagger", "info", "paths"],
      "properties": {
        "swagger": { "type": "string", "const": "2.0" },
        "info": {
          "type": "object",
          "required": ["title", "version"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "paths": { "type": "object" }
      }
    }
  ]
}
